# {{ ansible_managed | default('Géré par Ansible') }}
name: core

networks:
  # Seul Caddy y publie un port.
  public: {}
  # Trafic HTTP entre Caddy et les interfaces.
  edge:
    internal: true
  # Bases de données et services internes : sans passerelle.
  data:
    internal: true
  # Seule sortie : le pare-feu n'y autorise que l'AD et le serveur GPU.
  outbound:
    ipam:
      config:
        - subnet: {{ ia_outbound_subnet }}

x-service: &service
  restart: unless-stopped
  logging:
    driver: json-file
    options: {max-size: 50m, max-file: "5"}

x-gpu-hosts: &gpu_hosts
{% for host in groups['ai_gpu'] %}
  - "{{ hostvars[host].ia_fqdn }}:{{ hostvars[host].ansible_host }}"
{% endfor %}

x-langfuse-env: &langfuse_env
  DATABASE_URL: postgresql://langfuse:${PG_PASSWORD_LANGFUSE}@postgres:5432/langfuse
  NEXTAUTH_URL: https://{{ ia_fqdn_langfuse }}
  SALT: ${LANGFUSE_SALT}
  ENCRYPTION_KEY: ${LANGFUSE_ENCRYPTION_KEY}
  TELEMETRY_ENABLED: "false"
  CLICKHOUSE_MIGRATION_URL: clickhouse://clickhouse:9000
  CLICKHOUSE_URL: http://clickhouse:8123
  CLICKHOUSE_USER: clickhouse
  CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD}
  CLICKHOUSE_CLUSTER_ENABLED: "false"
  REDIS_HOST: redis
  REDIS_PORT: "6379"
  REDIS_AUTH: ${REDIS_PASSWORD}
  LANGFUSE_S3_EVENT_UPLOAD_BUCKET: langfuse
  LANGFUSE_S3_EVENT_UPLOAD_REGION: auto
  LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID: minio
  LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY: ${MINIO_PASSWORD}
  LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT: http://minio:9000
  LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE: "true"
  LANGFUSE_S3_EVENT_UPLOAD_PREFIX: events/
  LANGFUSE_S3_MEDIA_UPLOAD_BUCKET: langfuse
  LANGFUSE_S3_MEDIA_UPLOAD_REGION: auto
  LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID: minio
  LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY: ${MINIO_PASSWORD}
  LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT: http://minio:9000
  LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE: "true"
  LANGFUSE_S3_MEDIA_UPLOAD_PREFIX: media/

services:
  caddy:
    <<: *service
    image: {{ ia_image_mirror }}{{ ia_images.caddy }}
    ports:
      - "443:443"
    networks:
      public: {}
      edge:
        # Les services joignent le SSO par son vrai nom, sans passer par l'extérieur,
        # et vérifient son certificat.
        aliases:
          - {{ ia_fqdn_sso }}
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - {{ ia_tls_dir }}/fullchain.pem:/tls/fullchain.pem:ro
      - {{ ia_tls_dir }}/privkey.pem:/tls/privkey.pem:ro
      - caddy_data:/data
    healthcheck:
      test: ["CMD-SHELL", "nc -z 127.0.0.1 443"]
      interval: 30s
      timeout: 5s
      retries: 3

  postgres:
    <<: *service
    image: {{ ia_image_mirror }}{{ ia_images.postgres }}
    networks: [data]
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      PG_PASSWORD_KEYCLOAK: ${PG_PASSWORD_KEYCLOAK}
      PG_PASSWORD_LITELLM: ${PG_PASSWORD_LITELLM}
      PG_PASSWORD_OPENWEBUI: ${PG_PASSWORD_OPENWEBUI}
      PG_PASSWORD_LANGFUSE: ${PG_PASSWORD_LANGFUSE}
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./postgres/init.sh:/docker-entrypoint-initdb.d/10-init.sh:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 10

  keycloak:
    <<: *service
    image: {{ ia_image_mirror }}{{ ia_images.keycloak }}
    command: ["start", "--import-realm"]
    depends_on:
      postgres: {condition: service_healthy}
    networks: [edge, data, outbound]
    ports:
      # Administration locale par Ansible uniquement.
      - "127.0.0.1:8081:8080"
    environment:
      KC_DB: postgres
      KC_DB_URL_HOST: postgres
      KC_DB_URL_DATABASE: keycloak
      KC_DB_USERNAME: keycloak
      KC_DB_PASSWORD: ${PG_PASSWORD_KEYCLOAK}
      KC_HOSTNAME: https://{{ ia_fqdn_sso }}
      KC_HTTP_ENABLED: "true"
      KC_PROXY_HEADERS: xforwarded
      KC_HEALTH_ENABLED: "true"
      KC_METRICS_ENABLED: "true"
      KC_BOOTSTRAP_ADMIN_USERNAME: admin
      KC_BOOTSTRAP_ADMIN_PASSWORD: ${KEYCLOAK_ADMIN_PASSWORD}
      OIDC_SECRET_OPENWEBUI: ${OIDC_SECRET_OPENWEBUI}
      OIDC_SECRET_GRAFANA: ${OIDC_SECRET_GRAFANA}
      OIDC_SECRET_LANGFUSE: ${OIDC_SECRET_LANGFUSE}
{% if ia_ldap_enabled | bool %}
      LDAP_BIND_PASSWORD: ${LDAP_BIND_PASSWORD}
      KC_TRUSTSTORE_PATHS: /certs/ldap-ca.crt
{% endif %}
    volumes:
      - ./keycloak/realm.json:/opt/keycloak/data/import/realm.json:ro
{% if ia_ldap_enabled | bool %}
      - {{ ia_tls_dir }}/ldap-ca.crt:/certs/ldap-ca.crt:ro
{% endif %}
{% if ia_ldap_enabled | bool %}
    extra_hosts:
      - "{{ ia_ldap_url | urlsplit('hostname') }}:{{ ia_ldap_ip }}"
{% endif %}
    healthcheck:
      test: ["CMD-SHELL", "exec 3<>/dev/tcp/127.0.0.1/9000 && printf 'GET /health/ready HTTP/1.0\\r\\n\\r\\n' >&3 && grep -q '\"UP\"' <&3"]
      interval: 15s
      timeout: 10s
      retries: 10
      start_period: 120s

  litellm:
    <<: *service
    image: {{ ia_image_mirror }}{{ ia_images.litellm }}
    command: ["--config", "/app/config.yaml", "--port", "4000"]
    depends_on:
      postgres: {condition: service_healthy}
    networks: [edge, data, outbound]
    ports:
      # Administration locale par Ansible uniquement.
      - "127.0.0.1:4000:4000"
    extra_hosts: *gpu_hosts
    environment:
      DATABASE_URL: postgresql://litellm:${PG_PASSWORD_LITELLM}@postgres:5432/litellm
      LITELLM_MASTER_KEY: ${LITELLM_MASTER_KEY}
      LITELLM_SALT_KEY: ${LITELLM_SALT_KEY}
      VLLM_API_KEY: ${VLLM_API_KEY}
      STORE_MODEL_IN_DB: "False"
      # Pas de téléchargement de la table des prix au démarrage.
      LITELLM_LOCAL_MODEL_COST_MAP: "True"
      LANGFUSE_HOST: http://langfuse-web:3000
      LANGFUSE_PUBLIC_KEY: ${LANGFUSE_PUBLIC_KEY}
      LANGFUSE_SECRET_KEY: ${LANGFUSE_SECRET_KEY}
      SSL_CERT_FILE: /certs/ca.crt
    volumes:
      - ./litellm/config.yaml:/app/config.yaml:ro
      - {{ ia_tls_dir }}/ca.crt:/certs/ca.crt:ro
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:4000/health/liveliness', timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s

  open-webui:
    <<: *service
    image: {{ ia_image_mirror }}{{ ia_images.open_webui }}
    depends_on:
      postgres: {condition: service_healthy}
      qdrant: {condition: service_started}
      litellm: {condition: service_healthy}
      keycloak: {condition: service_healthy}
    networks: [edge, data]
    environment:
      WEBUI_NAME: Assistant IA
      WEBUI_URL: https://{{ ia_fqdn_chat }}
      WEBUI_SECRET_KEY: ${WEBUI_SECRET_KEY}
      # Sans cela, un compte désactivé dans l'AD garderait sa session ouverte.
      JWT_EXPIRES_IN: {{ ia_session_lifetime }}
      DATABASE_URL: postgresql://openwebui:${PG_PASSWORD_OPENWEBUI}@postgres:5432/openwebui
      # L'inventaire reste la seule source de vérité, pas la base de données.
      ENABLE_PERSISTENT_CONFIG: "false"
      OFFLINE_MODE: "true"
      HF_HUB_OFFLINE: "1"
      SCARF_NO_ANALYTICS: "true"
      DO_NOT_TRACK: "true"
      ANONYMIZED_TELEMETRY: "false"
      ENABLE_OLLAMA_API: "false"
      ENABLE_WEB_SEARCH: "false"
      ENABLE_SIGNUP: "false"
      ENABLE_LOGIN_FORM: "false"
      ENABLE_FORWARD_USER_INFO_HEADERS: "true"
      OPENAI_API_BASE_URLS: http://litellm:4000/v1
      OPENAI_API_KEYS: ${LITELLM_KEY_OPENWEBUI}
      DEFAULT_MODELS: assistant
{% if ia_models | selectattr('model', 'equalto', 'gemma_4_e4b') | list | length > 0 %}
      TASK_MODEL_EXTERNAL: assistant-leger
{% endif %}
      # SSO : les groupes de l'annuaire donnent les rôles et les droits.
      OAUTH_PROVIDER_NAME: Compte entreprise
      OPENID_PROVIDER_URL: https://{{ ia_fqdn_sso }}/realms/ia/.well-known/openid-configuration
      OPENID_REDIRECT_URI: https://{{ ia_fqdn_chat }}/oauth/oidc/callback
      OAUTH_CLIENT_ID: open-webui
      OAUTH_CLIENT_SECRET: ${OIDC_SECRET_OPENWEBUI}
      OAUTH_SCOPES: openid email profile
      ENABLE_OAUTH_SIGNUP: "true"
      OAUTH_MERGE_ACCOUNTS_BY_EMAIL: "false"
      ENABLE_OAUTH_ROLE_MANAGEMENT: "true"
      OAUTH_ROLES_CLAIM: groups
      OAUTH_ALLOWED_ROLES: {{ ia_group_users }},{{ ia_group_admins }}
      OAUTH_ADMIN_ROLES: {{ ia_group_admins }}
      ENABLE_OAUTH_GROUP_MANAGEMENT: "true"
      ENABLE_OAUTH_GROUP_CREATION: "true"
      OAUTH_GROUP_CLAIM: groups
      SSL_CERT_FILE: /certs/ca.crt
      REQUESTS_CA_BUNDLE: /certs/ca.crt
      # RAG
      VECTOR_DB: qdrant
      QDRANT_URI: http://qdrant:6333
      QDRANT_API_KEY: ${QDRANT_API_KEY}
      CONTENT_EXTRACTION_ENGINE: docling
      DOCLING_SERVER_URL: http://docling:5001
      RAG_EMBEDDING_ENGINE: openai
      RAG_OPENAI_API_BASE_URL: http://litellm:4000/v1
      RAG_OPENAI_API_KEY: ${LITELLM_KEY_OPENWEBUI}
      RAG_EMBEDDING_MODEL: bge-m3
      ENABLE_RAG_HYBRID_SEARCH: "true"
      RAG_RERANKING_ENGINE: external
      RAG_EXTERNAL_RERANKER_URL: http://litellm:4000/rerank
      RAG_EXTERNAL_RERANKER_API_KEY: ${LITELLM_KEY_OPENWEBUI}
      RAG_RERANKING_MODEL: bge-reranker
    volumes:
      - openwebui_data:/app/backend/data
      - {{ ia_tls_dir }}/ca.crt:/certs/ca.crt:ro
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:8080/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 180s

  qdrant:
    <<: *service
    image: {{ ia_image_mirror }}{{ ia_images.qdrant }}
    networks: [data]
    environment:
      QDRANT__SERVICE__API_KEY: ${QDRANT_API_KEY}
      QDRANT__TELEMETRY_DISABLED: "true"
    volumes:
      - qdrant_data:/qdrant/storage
      - qdrant_snapshots:/qdrant/snapshots

  docling:
    <<: *service
    image: {{ ia_image_mirror }}{{ ia_images.docling }}
    networks: [data]
    environment:
      DOCLING_SERVE_ENABLE_UI: "false"
      HF_HUB_OFFLINE: "1"
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:5001/health', timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s

  langfuse-web:
    <<: *service
    image: {{ ia_image_mirror }}{{ ia_images.langfuse_web }}
    depends_on: &langfuse_depends
      postgres: {condition: service_healthy}
      clickhouse: {condition: service_healthy}
      redis: {condition: service_healthy}
      minio: {condition: service_healthy}
    networks: [edge, data]
    environment:
      <<: *langfuse_env
      NEXTAUTH_SECRET: ${LANGFUSE_NEXTAUTH_SECRET}
      NODE_EXTRA_CA_CERTS: /certs/ca.crt
      AUTH_DISABLE_SIGNUP: "false"
      AUTH_DISABLE_USERNAME_PASSWORD: "true"
      AUTH_KEYCLOAK_CLIENT_ID: langfuse
      AUTH_KEYCLOAK_CLIENT_SECRET: ${OIDC_SECRET_LANGFUSE}
      AUTH_KEYCLOAK_ISSUER: https://{{ ia_fqdn_sso }}/realms/ia
      AUTH_KEYCLOAK_ALLOW_ACCOUNT_LINKING: "true"
      LANGFUSE_INIT_ORG_ID: entreprise
      LANGFUSE_INIT_ORG_NAME: {{ ia_langfuse_org_name }}
      LANGFUSE_INIT_PROJECT_ID: assistant-ia
      LANGFUSE_INIT_PROJECT_NAME: {{ ia_langfuse_project_name }}
      LANGFUSE_INIT_PROJECT_PUBLIC_KEY: ${LANGFUSE_PUBLIC_KEY}
      LANGFUSE_INIT_PROJECT_SECRET_KEY: ${LANGFUSE_SECRET_KEY}
      LANGFUSE_INIT_USER_EMAIL: {{ ia_admin_email }}
      LANGFUSE_INIT_USER_NAME: Administrateur
      LANGFUSE_INIT_USER_PASSWORD: ${LANGFUSE_INIT_USER_PASSWORD}
    volumes:
      - {{ ia_tls_dir }}/ca.crt:/certs/ca.crt:ro
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://$$HOSTNAME:3000/api/public/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      # Le premier démarrage applique plusieurs centaines de migrations.
      start_period: 300s

  langfuse-worker:
    <<: *service
    image: {{ ia_image_mirror }}{{ ia_images.langfuse_worker }}
    depends_on: *langfuse_depends
    networks: [data]
    environment: *langfuse_env
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://$$HOSTNAME:3030/api/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s

  clickhouse:
    <<: *service
    image: {{ ia_image_mirror }}{{ ia_images.clickhouse }}
    user: "101:101"
    networks: [data]
    environment:
      CLICKHOUSE_DB: default
      CLICKHOUSE_USER: clickhouse
      CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD}
    volumes:
      - clickhouse_data:/var/lib/clickhouse
      - clickhouse_logs:/var/log/clickhouse-server
    healthcheck:
      test: wget --no-verbose --tries=1 --spider http://localhost:8123/ping || exit 1
      interval: 10s
      timeout: 5s
      retries: 10

  redis:
    <<: *service
    image: {{ ia_image_mirror }}{{ ia_images.redis }}
    command: ["redis-server", "--requirepass", "${REDIS_PASSWORD}", "--maxmemory-policy", "noeviction"]
    networks: [data]
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a \"$$REDIS_PASSWORD\" --no-auth-warning ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 10
    environment:
      REDIS_PASSWORD: ${REDIS_PASSWORD}

  minio:
    <<: *service
    image: {{ ia_image_mirror }}{{ ia_images.minio }}
    entrypoint: sh
    command: ["-c", "mkdir -p /data/langfuse && minio server --address ':9000' --console-address ':9001' /data"]
    networks: [data]
    environment:
      MINIO_ROOT_USER: minio
      MINIO_ROOT_PASSWORD: ${MINIO_PASSWORD}
      MINIO_BROWSER: "off"
    volumes:
      - minio_data:/data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 10s
      timeout: 5s
      retries: 10

  prometheus:
    <<: *service
    image: {{ ia_image_mirror }}{{ ia_images.prometheus }}
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ ia_prometheus_retention }}
    networks: [edge, outbound]
    extra_hosts: *gpu_hosts
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./prometheus/rules.yml:/etc/prometheus/rules.yml:ro
      - {{ ia_tls_dir }}/ca.crt:/certs/ca.crt:ro
      - prometheus_data:/prometheus
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1:9090/-/ready"]
      interval: 30s
      timeout: 5s
      retries: 5

  grafana:
    <<: *service
    image: {{ ia_image_mirror }}{{ ia_images.grafana }}
    depends_on:
      prometheus: {condition: service_started}
    networks: [edge]
    environment:
      GF_SERVER_ROOT_URL: https://{{ ia_fqdn_grafana }}
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD}
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: "false"
      GF_AUTH_DISABLE_LOGIN_FORM: "true"
      GF_AUTH_GENERIC_OAUTH_ENABLED: "true"
      GF_AUTH_GENERIC_OAUTH_NAME: Compte entreprise
      GF_AUTH_GENERIC_OAUTH_AUTO_LOGIN: "true"
      GF_AUTH_GENERIC_OAUTH_CLIENT_ID: grafana
      GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET: ${OIDC_SECRET_GRAFANA}
      GF_AUTH_GENERIC_OAUTH_SCOPES: openid email profile
      GF_AUTH_GENERIC_OAUTH_AUTH_URL: https://{{ ia_fqdn_sso }}/realms/ia/protocol/openid-connect/auth
      GF_AUTH_GENERIC_OAUTH_TOKEN_URL: https://{{ ia_fqdn_sso }}/realms/ia/protocol/openid-connect/token
      GF_AUTH_GENERIC_OAUTH_API_URL: https://{{ ia_fqdn_sso }}/realms/ia/protocol/openid-connect/userinfo
      GF_AUTH_GENERIC_OAUTH_TLS_CLIENT_CA: /certs/ca.crt
      GF_AUTH_GENERIC_OAUTH_GROUPS_ATTRIBUTE_PATH: groups
      GF_AUTH_GENERIC_OAUTH_ALLOWED_GROUPS: {{ ia_group_admins }}
      GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH: contains(groups[*], '{{ ia_group_admins }}') && 'Admin' || 'Viewer'
      GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN: "true"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
      - {{ ia_tls_dir }}/ca.crt:/certs/ca.crt:ro
      - grafana_data:/var/lib/grafana
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1:3000/api/health"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 60s

  node-exporter:
    <<: *service
    image: {{ ia_image_mirror }}{{ ia_images.node_exporter }}
    network_mode: host
    pid: host
    command:
      - --path.rootfs=/host
      - --web.listen-address={{ ansible_host }}:9100
    volumes:
      - /:/host:ro,rslave

volumes:
  caddy_data:
  postgres_data:
  openwebui_data:
  qdrant_data:
  qdrant_snapshots:
  clickhouse_data:
  clickhouse_logs:
  redis_data:
  minio_data:
  prometheus_data:
  grafana_data:
