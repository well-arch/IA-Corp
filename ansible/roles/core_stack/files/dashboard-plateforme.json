{
  "uid": "plateforme-ia",
  "title": "Plateforme IA",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1, "title": "Requêtes en cours et en attente", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (modele) (vllm:num_requests_running)", "legendFormat": "{{modele}} en cours"},
        {"refId": "B", "expr": "sum by (modele) (vllm:num_requests_waiting)", "legendFormat": "{{modele}} en attente"}
      ]
    },
    {
      "id": 2, "title": "Jetons générés par seconde", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum by (modele) (rate(vllm:generation_tokens_total[5m]))", "legendFormat": "{{modele}}"}
      ]
    },
    {
      "id": 3, "title": "Utilisation GPU", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU {{gpu}}"}
      ]
    },
    {
      "id": 4, "title": "Mémoire GPU utilisée", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "decmbytes", "min": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "DCGM_FI_DEV_FB_USED", "legendFormat": "GPU {{gpu}}"}
      ]
    },
    {
      "id": 5, "title": "Cibles injoignables", "type": "stat",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "count(up == 0) or vector(0)"}]
    },
    {
      "id": 6, "title": "Espace disque libre", "type": "bargauge",
      "gridPos": {"h": 6, "w": 16, "x": 8, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}", "legendFormat": "{{instance}} {{mountpoint}}"}
      ]
    }
  ]
}
